NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase's dashboard may label this "anon key" or "publishable key"
# depending on when your project was created — either works here, use
# whichever name Supabase shows you and either env var name below.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
